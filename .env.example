# Copy this file to .env (same folder as docker-compose.yml) and fill in
# real values before running `docker compose up`. .env is gitignored and
# never committed - this .example file is the only one tracked by git.

# ---- Database ----
POSTGRES_DB=retailforge2
POSTGRES_USER=retailforge2_user
POSTGRES_PASSWORD=retailforge2_dev_password

# ---- Stripe ----
# Test keys (sk_test_/pk_test_) work fine for local checkout testing.
STRIPE_SECRET_KEY=sk_test_your-real-key-here
STRIPE_PUBLISHABLE_KEY=pk_test_your-real-key-here

# ---- AI chat widget ----
# Only the provider selected by spring.ai.model.chat in
# backend/src/main/resources/application.properties is actually called
# (currently "openai"), but both keys can be set safely either way.
SPRING_AI_OPENAI_API_KEY=sk-your-real-openai-key-here
SPRING_AI_ANTHROPIC_API_KEY=sk-your-real-anthropic-key-here

# ---- Frontend build ----
# Baked into the frontend's JS bundle at `docker compose build` time - must
# match wherever the backend container ends up published. Also note the
# backend's CORS config (backend/.../security/SecurityConfig.java) is
# hardcoded to allow only http://localhost:5173, so leave the frontend
# container's published port as 5173 (see docker-compose.yml) unless you
# also change that origin in the Java source.
VITE_API_BASE_URL=http://localhost:8080
