VITE_API_BASE_URL=http://localhost:8080

# Stripe publishable key (safe to expose client-side). Required by
# CheckoutPage.tsx / AppRoutes.tsx (loadStripe(...)) - checkout will fail
# without it. Get a test key from your Stripe dashboard's Developers ->
# API keys page; sk_test_/pk_test_ keys work for local testing.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-real-key-here
